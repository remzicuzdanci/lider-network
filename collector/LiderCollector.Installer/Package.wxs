<?xml version="1.0" encoding="utf-8"?>
<!--
  Lider IT ONE Collector — WiX v4 Package definition.

  UPGRADE SAFETY:
    MajorUpgrade removes old binaries from ProgramFiles before installing new ones.
    All mutable state (collector.json, secure.dat, queue.db, logs) lives in
    %ProgramData%\LiderCollector\ and is NOT touched by upgrade/uninstall.

  TOKEN SECURITY:
    No enrollment token is embedded in the MSI or passed on the command line.
    IT deploys enrollment.json to %ProgramData%\LiderCollector\ separately
    (via GPO Preferences file copy, SCCM, robocopy, etc.) before the first
    service start.  The agent reads and immediately deletes it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Lider IT ONE Collector"
    Manufacturer="Lider Network"
    Version="1.0.0"
    UpgradeCode="B6A3F291-9D4E-4C7B-8F12-3A5E6D1C0847"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes"
    Language="1033">

    <!-- ── Upgrade handling ─────────────────────────────────────────────── -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Lider IT ONE Collector is already installed."
      AllowSameVersionUpgrades="no"
      Schedule="afterInstallInitialize" />

    <!-- ── Media ────────────────────────────────────────────────────────── -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ── Feature ──────────────────────────────────────────────────────── -->
    <Feature Id="ProductFeature" Title="Lider IT ONE Collector" Level="1">
      <ComponentGroupRef Id="CollectorBinaries" />
      <ComponentGroupRef Id="DataDirectory" />
    </Feature>

    <!-- ── UI: silent install only (no dialog sequence) ────────────────── -->
    <!-- ALLUSERS=1 is set implicitly by Scope="perMachine" above -->

    <!-- Enrollment custom action:
         Reads deploy token from [OriginalDatabase] (the MSI filename),
         calls /api/v1/collector/auto-enroll, writes enrollment.json.
         Runs as SYSTEM (Impersonate=no) so it can write to ProgramData.
         Only executes on fresh install, not on upgrade.
    -->

    <!-- Pass MSI path to the deferred CA via CustomActionData -->
    <SetProperty Id="LiderEnrollCA"
                 Value="[OriginalDatabase]"
                 Sequence="execute"
                 Before="LiderEnrollCA" />

    <!-- Embed VBScript in Binary table (supports >255 chars) -->
    <Binary Id="LiderEnrollScript" SourceFile="enroll.vbs" />

    <!-- Deferred VBScript CA - runs as SYSTEM after CreateFolders -->
    <CustomAction Id="LiderEnrollCA"
                  BinaryRef="LiderEnrollScript"
                  VBScriptCall=""
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <!-- Fresh install only; upgrades keep existing enrollment.json -->
      <Custom Action="LiderEnrollCA" After="CreateFolders" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>
</Wix>
