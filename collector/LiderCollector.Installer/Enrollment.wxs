<?xml version="1.0" encoding="utf-8"?>
<!--
  Enrollment custom action — reads deploy token from MSI filename,
  calls /api/v1/collector/auto-enroll, writes enrollment.json.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>

    <!-- Pass OriginalDatabase to the deferred CA via CustomActionData -->
    <SetProperty Id="LiderEnrollCA"
                 Value="[OriginalDatabase]"
                 Sequence="execute"
                 Before="LiderEnrollCA" />

    <!-- Deferred CA — runs as SYSTEM (Impersonate=no) after CreateFolders -->
    <CustomAction Id="LiderEnrollCA"
                  Script="vbscript"
                  ScriptSourceFile="enroll.vbs"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <!-- Only on fresh install; upgrades preserve existing enrollment.json -->
      <Custom Action="LiderEnrollCA" After="CreateFolders" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Fragment>
</Wix>
