<?xml version="1.0" encoding="utf-8"?>
<!--
  LiderCollector.admx — Administrative Template for Lider IT ONE Collector

  Copy to:
    %SystemRoot%\PolicyDefinitions\LiderCollector.admx      (Central Store or local)
    \\<DOMAIN>\SYSVOL\<DOMAIN>\Policies\PolicyDefinitions\  (Central Store — recommended)

  The corresponding .adml goes in the en-US subfolder.

  REGISTRY KEYS written by GPO:
    HKLM\SOFTWARE\Policies\LiderNetwork\LiderCollector\
      ServerUrl     (REG_SZ)   — HTTPS URL of the Lider IT ONE server
      DataDir       (REG_SZ)   — Override for data directory (default: %ProgramData%\LiderCollector\)
      LogLevel      (REG_SZ)   — Serilog log level: Verbose/Debug/Information/Warning/Error
      HeartbeatIntervalSeconds   (REG_DWORD)
      InventorySyncIntervalSeconds (REG_DWORD)

  WHAT IS NOT STORED IN REGISTRY / GPO:
    - Enrollment tokens (never — tokens are deployed as enrollment.json file)
    - API keys          (stored in DPAPI)

  NOTE: The collector reads these GPO registry keys at startup.
  If a key is not present the value in collector.json is used instead.
-->
<policyDefinitions
  xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions"
  revision="1.0"
  schemaVersion="1.0">

  <policyNamespaces>
    <target prefix="liderCollector"
            namespace="LiderNetwork.LiderCollector.Policies" />
  </policyNamespaces>

  <resources minRequiredRevision="1.0" />

  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_WIN10_AND_LATER"
                  displayName="$(string.SUPPORTED_WIN10_AND_LATER)" />
    </definitions>
  </supportedOn>

  <categories>
    <category name="LiderNetwork" displayName="$(string.CategoryLiderNetwork)" />
    <category name="LiderCollector" displayName="$(string.CategoryLiderCollector)">
      <parentCategory ref="LiderNetwork" />
    </category>
  </categories>

  <policies>

    <!-- ── Server URL ───────────────────────────────────────────────────── -->
    <policy
      name="ServerUrl"
      class="Machine"
      displayName="$(string.PolicyServerUrl_Name)"
      explainText="$(string.PolicyServerUrl_Explain)"
      presentation="$(presentation.PolicyServerUrl)"
      key="SOFTWARE\Policies\LiderNetwork\LiderCollector"
      valueName="ServerUrl">
      <parentCategory ref="LiderCollector" />
      <supportedOn ref="SUPPORTED_WIN10_AND_LATER" />
      <elements>
        <text
          id="ServerUrlText"
          valueName="ServerUrl"
          required="true"
          maxLength="512" />
      </elements>
    </policy>

    <!-- ── Heartbeat interval ────────────────────────────────────────────── -->
    <policy
      name="HeartbeatInterval"
      class="Machine"
      displayName="$(string.PolicyHeartbeat_Name)"
      explainText="$(string.PolicyHeartbeat_Explain)"
      presentation="$(presentation.PolicyHeartbeat)"
      key="SOFTWARE\Policies\LiderNetwork\LiderCollector"
      valueName="HeartbeatIntervalSeconds">
      <parentCategory ref="LiderCollector" />
      <supportedOn ref="SUPPORTED_WIN10_AND_LATER" />
      <elements>
        <decimal
          id="HeartbeatDecimal"
          valueName="HeartbeatIntervalSeconds"
          minValue="30"
          maxValue="3600" />
      </elements>
    </policy>

    <!-- ── Inventory sync interval ──────────────────────────────────────── -->
    <policy
      name="InventorySyncInterval"
      class="Machine"
      displayName="$(string.PolicyInventory_Name)"
      explainText="$(string.PolicyInventory_Explain)"
      presentation="$(presentation.PolicyInventory)"
      key="SOFTWARE\Policies\LiderNetwork\LiderCollector"
      valueName="InventorySyncIntervalSeconds">
      <parentCategory ref="LiderCollector" />
      <supportedOn ref="SUPPORTED_WIN10_AND_LATER" />
      <elements>
        <decimal
          id="InventoryDecimal"
          valueName="InventorySyncIntervalSeconds"
          minValue="300"
          maxValue="86400" />
      </elements>
    </policy>

    <!-- ── Log level ─────────────────────────────────────────────────────── -->
    <policy
      name="LogLevel"
      class="Machine"
      displayName="$(string.PolicyLogLevel_Name)"
      explainText="$(string.PolicyLogLevel_Explain)"
      presentation="$(presentation.PolicyLogLevel)"
      key="SOFTWARE\Policies\LiderNetwork\LiderCollector"
      valueName="LogLevel">
      <parentCategory ref="LiderCollector" />
      <supportedOn ref="SUPPORTED_WIN10_AND_LATER" />
      <elements>
        <enum id="LogLevelEnum" valueName="LogLevel">
          <item displayName="$(string.LogLevel_Information)">
            <value><string>Information</string></value>
          </item>
          <item displayName="$(string.LogLevel_Warning)">
            <value><string>Warning</string></value>
          </item>
          <item displayName="$(string.LogLevel_Debug)">
            <value><string>Debug</string></value>
          </item>
          <item displayName="$(string.LogLevel_Verbose)">
            <value><string>Verbose</string></value>
          </item>
        </enum>
      </elements>
    </policy>

  </policies>
</policyDefinitions>
